# Copy to .env and fill in. NEVER commit .env.

SNOWFLAKE_ACCOUNT=xxxxxx-yyyyyy        # e.g. orgname-accountname
SNOWFLAKE_USER=YOUR_SERVICE_OR_OWN_USER
SNOWFLAKE_ROLE=APP_ROLE
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=APP_DB
SNOWFLAKE_SCHEMA=PUBLIC

# One of: externalbrowser (SSO, best for local dev) | password | keypair
SNOWFLAKE_AUTHENTICATOR=externalbrowser

# only if SNOWFLAKE_AUTHENTICATOR=password
SNOWFLAKE_PASSWORD=

# only if SNOWFLAKE_AUTHENTICATOR=keypair
SNOWFLAKE_PRIVATE_KEY_PATH=
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=

# App settings
ORDERS_TABLE=PRODUCTION_ORDERS
USERS_TABLE=APP_USERS
AUDIT_TABLE=AUDIT_LOG
MAX_ROWS=50000
SESSION_TIMEOUT_MINUTES=30
CACHE_TTL_SECONDS=60
ACCESS_TABLE=ROLE_COLUMN_ACCESS
